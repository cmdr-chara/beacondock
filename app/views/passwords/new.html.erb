<% content_for :title, t(".title") %>

<div class="auth-card">
  <h1><%= t(".title") %></h1>

  <%= form_with url: passwords_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email_address, t("activerecord.attributes.user.email_address") %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <%= form.submit t(".submit"), class: "btn btn-primary btn-block" %>
  <% end %>
</div>
