<%= tag.article id: dom_id(monitor), class: "monitor-card status-#{monitor.last_status}" do %>
  <header class="monitor-card-header">
    <div>
      <h2 class="monitor-name"><%= link_to monitor.name, monitor %></h2>
      <span class="monitor-host"><%= monitor.host %></span>
    </div>
    <%= status_badge(monitor.last_status) %>
  </header>

  <div class="monitor-stats">
    <div class="stat">
      <span class="stat-label"><%= t("monitors.uptime_24h") %></span>
      <span class="stat-value"><%= format_uptime(monitor, 24.hours) %></span>
    </div>
    <div class="stat">
      <span class="stat-label"><%= t("monitors.uptime_30d") %></span>
      <span class="stat-value"><%= format_uptime(monitor, 30.days) %></span>
    </div>
    <div class="stat">
      <span class="stat-label"><%= t("monitors.latency") %></span>
      <span class="stat-value"><%= format_latency(monitor.checks.first&.latency_ms) %></span>
    </div>
  </div>

  <div class="monitor-sparkline">
    <%= latency_sparkline(monitor) %>
  </div>

  <footer class="monitor-card-footer">
    <span><%= t("monitors.checked_ago", time: format_check_time(monitor.last_checked_at)) %></span>
    <span><%= t("monitors.every", seconds: monitor.interval_seconds) %></span>
  </footer>
<% end %>
