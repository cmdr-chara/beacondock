<% content_for :title, t(".title") %>

<div class="status-page">
  <% if @monitors.empty? %>
    <div class="status-hero status-hero-empty">
      <div class="status-hero-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      </div>
      <div>
        <h1><%= t(".empty") %></h1>
        <p class="status-hero-sub"><%= t(".empty_hint") %></p>
      </div>
    </div>
  <% else %>
    <% overall = if @monitors.any?(&:last_status_down?)
                   :down
                 elsif @monitors.any?(&:last_status_degraded?)
                   :degraded
                 elsif @monitors.all?(&:last_status_pending?)
                   :pending
                 else
                   :up
                 end %>
    <section class="status-hero status-hero-<%= overall %>" aria-labelledby="status-heading">
      <div class="status-hero-icon">
        <% if overall == :up %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        <% elsif overall == :down %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 8v5M12 16.5v.5"/><circle cx="12" cy="12" r="9.2"/></svg>
        <% else %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9.2"/></svg>
        <% end %>
      </div>
      <div>
        <h1 id="status-heading"><%= t(".banner.#{overall}") %></h1>
        <p class="status-hero-sub"><%= t(".updated", time: l(Time.current, format: :short)) %></p>
      </div>
    </section>

    <section class="status-monitors" aria-label="<%= t(".monitors_label") %>">
      <% @monitors.each do |monitor| %>
        <article class="status-row status-<%= monitor.last_status %>">
          <div class="status-row-id">
            <span class="status-dot" aria-hidden="true"></span>
            <div>
              <h2 class="status-row-name"><%= monitor.name %></h2>
              <span class="status-row-host"><%= monitor.host %></span>
            </div>
          </div>

          <div class="uptime-bars" role="img"
               aria-label="<%= t(".uptime_bars_label", name: monitor.name) %>">
            <% status_bars(monitor).each do |day| %>
              <span class="uptime-bar uptime-bar-<%= day[:status] || "none" %>"
                    title="<%= "#{l(day[:date], format: :short)} · #{day[:status] ? t("statuses.#{day[:status]}") : t("common.no_data")}" %>"></span>
            <% end %>
          </div>

          <div class="status-row-metrics">
            <div class="status-metric">
              <span class="stat-label"><%= t("monitors.uptime_24h") %></span>
              <span class="stat-value"><%= format_uptime(monitor, 24.hours) %></span>
            </div>
            <div class="status-metric">
              <span class="stat-label"><%= t("monitors.uptime_30d") %></span>
              <span class="stat-value"><%= format_uptime(monitor, 30.days) %></span>
            </div>
          </div>

          <%= status_badge(monitor.last_status) %>
        </article>
      <% end %>
    </section>

    <% if @recent_incidents.any? %>
      <section class="panel">
        <h2><%= t(".recent_incidents") %></h2>
        <ul class="incident-list">
          <% @recent_incidents.each do |incident| %>
            <li>
              <span class="incident-main">
                <strong><%= incident.monitor.name %></strong> —
                <%= incident.cause || t("incidents.unknown_cause") %>
              </span>
              <span class="incident-meta">
                <%= l(incident.started_at, format: :short) %>
                <% if incident.resolved_at %>
                  → <%= l(incident.resolved_at, format: :short) %>
                <% else %>
                  · <span class="badge badge-down"><%= t("incidents.ongoing") %></span>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>

  <footer class="status-foot">
    <%= t(".powered_by") %> <%= link_to "BeaconDock", root_path %>
  </footer>
</div>
