        <a class="btn btn--primary" href="<%= sign_up_path %>"><%= t("landing.close.cta") %><svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
      </div>
      <p class="close__word" aria-hidden="true"><%= t("landing.close.word") %></p>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-6 stack-4">
          <a class="nav__logo" href="#top">BeaconDock</a>
          <p class="footer__lede"><%= t("landing.close.lede") %></p>
        </div>
        <div class="span-2 footer__col"><h3><%= t("landing.close.col_product") %></h3><ul>
          <li><a href="#product"><%= t("landing.close.link_product") %></a></li>
          <li><a href="#checks"><%= t("landing.close.link_features") %></a></li>
          <li><a href="#faq"><%= t("landing.close.link_faq") %></a></li>
        </ul></div>
        <div class="span-2 footer__col"><h3><%= t("landing.close.col_dev") %></h3><ul>
          <li><a href="#checks"><%= t("landing.close.link_api") %></a></li>
          <li><a href="#product"><%= t("landing.close.link_status") %></a></li>
        </ul></div>
        <div class="span-2 footer__col"><h3><%= t("landing.close.col_account") %></h3><ul>
          <li><a href="<%= new_session_path %>"><%= t("landing.close.link_signin") %></a></li>
          <li><a href="<%= sign_up_path %>"><%= t("landing.close.link_signup") %></a></li>
        </ul></div>
      </div>
      <div class="footer__legal">
        <span><%= t("landing.close.legal") %></span>
      </div>
    </div>
  </div>
</footer>

<script type="module" src="/taste/system.js"></script>
