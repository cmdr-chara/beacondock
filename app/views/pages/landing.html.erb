<% content_for :title, t("landing.meta.title") %>
<% content_for :head do %>
<meta name="description" content="<%= t("landing.meta.description") %>">
<% end %>
<!doctype html>
<!-- BeaconDock landing — custom terminal design: the page is one live
     ops session (watch → man → status → api → faq → start). -->
<html lang="<%= I18n.locale %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= t("landing.meta.title") %></title>
<meta name="description" content="<%= t("landing.meta.description") %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= t("landing.meta.title") %>">
<meta property="og:description" content="<%= t("landing.meta.description") %>">
<meta property="og:image" content="/share.jpg">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<meta name="theme-color" content="#0d100c">
<link rel="preload" href="/fonts/geist-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/geist-mono-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
<style>
@font-face { font-family: "Geist Mono"; font-style: normal; font-weight: 400; font-display: swap; src: url("/fonts/geist-mono-latin-400-normal.woff2") format("woff2"); }
@font-face { font-family: "Geist Mono"; font-style: normal; font-weight: 500; font-display: swap; src: url("/fonts/geist-mono-latin-500-normal.woff2") format("woff2"); }
:root {
  --bg: #0d100c; --fg: #e8e3d3; --dim: #a2a78f; --faint: #848a6f; --line: #242a20;
  --up: #6ee787; --warn: #e3b341; --down: #ff7b72; --cyan: #79c0d8; --amber: #f5b942;
  --mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
* { box-sizing: border-box; }
html { scroll-padding-top: 68px; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 400 15px/1.7 var(--mono); -webkit-font-smoothing: antialiased; }
::selection { background: var(--amber); color: var(--bg); }
a { color: inherit; }
:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
.skip { position: absolute; left: 8px; top: 8px; transform: translateY(-260%); background: var(--fg); color: var(--bg); padding: 6px 12px; z-index: 99; }
.skip:focus { transform: none; }
.vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
main h1 { margin: 0; font-size: inherit; font-weight: 400; line-height: inherit; letter-spacing: 0; }

/* ---------- top bar ---------- */
.nav { position: fixed; inset: 0 0 auto; z-index: 10; display: flex; align-items: center; gap: 2.5ch;
  height: 52px; padding: 0 max(22px, calc((100vw - 90ch) / 2 + 22px));
  background: rgb(13 16 12 / .92); backdrop-filter: blur(6px);
  border-bottom: 1px solid var(--line); }
.nav__logo { font-weight: 500; text-decoration: none; letter-spacing: -.01em; display: inline-flex; align-items: center; min-height: 44px; }
.nav__logo .cur { margin-left: 2px; }
.nav__links { display: flex; gap: 2.2ch; margin-left: 2ch; }
.nav__links a { color: var(--dim); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
.nav__links a:hover { color: var(--amber); }
.nav__act { margin-left: auto; display: flex; align-items: center; gap: 2.2ch; }
.signin { color: var(--dim); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
.signin:hover { color: var(--fg); }
.btn-inv { background: var(--fg); color: var(--bg); text-decoration: none; padding: 0 1.15em; font-weight: 500; border-radius: 2px; display: inline-flex; align-items: center; min-height: 44px; }
.btn-inv:hover { background: var(--amber); color: var(--bg); }
.btn-inv:focus-visible { background: var(--amber); color: var(--bg); }
.signin:focus-visible { color: var(--amber); }

/* ---------- the session column ---------- */
.term { max-width: 90ch; margin-inline: auto; padding: 0 22px; }
main { padding-top: 52px; }
.tl { margin: 0; }
.dim { color: var(--dim); } .faint { color: var(--faint); }
.up { color: var(--up); } .warn { color: var(--warn); } .down { color: var(--down); }
.cyan { color: var(--cyan); } .amber { color: var(--amber); }
.ps1 { color: var(--dim); } .p1 { color: var(--amber); }
.bars { color: var(--dim); }
.cur { display: inline-block; width: .62em; height: 1.12em; background: var(--amber);
  vertical-align: -0.16em; animation: blink 1.06s steps(2, jump-none) 4; }
@keyframes blink { 50% { opacity: 0; } }
.typed { display: inline-block; overflow: hidden; white-space: nowrap; width: 0;
  vertical-align: -0.18em; animation: type 1s steps(22, end) .4s forwards; }
@keyframes type { to { width: 22ch; } }
@media (prefers-reduced-motion: reduce) {
  .cur, .typed { animation: none !important; }
  .typed { width: auto !important; }
  html { scroll-behavior: auto; }
}

/* ---------- sections ---------- */
.tsec { padding-block: 54px; }
.tsec--hero { padding-top: 46px; min-height: calc(100svh - 52px); }
.tsec__h { display: flex; align-items: baseline; gap: 1.2ch; margin: 0 0 6px;
  font-size: inherit; font-weight: 500; letter-spacing: 0; }
.tsec__h::before { content: "$"; color: var(--amber); }
.tsec__h::after { content: ""; flex: 1; border-bottom: 1px solid var(--line); margin-left: 1ch; }

/* ---------- monitor table ---------- */
.tt-wrap { overflow-x: auto; margin-top: 12px; }
.tt { border-collapse: collapse; font: inherit; white-space: nowrap; }
.tt th { font-weight: 500; color: var(--dim); text-align: left; padding: 0 2.4ch 5px 0; font-size: 12px; letter-spacing: .07em; }
.tt td { padding: 2.5px 2.4ch 2.5px 0; }
.tt .pct { color: var(--dim); }
.log { margin-top: 12px; }

/* ---------- status pane ---------- */
.pane { border: 1px solid var(--line); border-radius: 3px; padding: 14px 18px; margin-top: 14px;
  background: #10140f; overflow-x: auto; }
.pane__head { display: flex; gap: 2.5ch; align-items: baseline; padding-bottom: 8px; margin-bottom: 6px;
  border-bottom: 1px solid var(--line); white-space: nowrap; }
.pane__row { display: grid; grid-template-columns: minmax(0,1fr) auto auto; gap: 2.6ch; align-items: baseline;
  padding: 3px 0; white-space: nowrap; }
.pane__row .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pane__row .st { width: 5ch; text-align: right; }
.bars--s { display: none; }

/* ---------- code / output ---------- */
.pre { margin: 12px 0 0; padding: 12px 16px; border-left: 2px solid var(--faint);
  white-space: pre-wrap; overflow-wrap: anywhere; }
.pre .k { color: var(--amber); } .pre .s { color: var(--cyan); } .pre .c { color: var(--dim); }

/* ---------- man page ---------- */
.man { display: grid; gap: 14px; margin-top: 16px; }
.man > div { display: grid; grid-template-columns: 15ch 1fr; gap: 2ch; }
.man dt { color: var(--amber); font-weight: 500; }
.man dd { margin: 0; }

/* ---------- faq ---------- */
.qa { display: grid; gap: 14px; margin-top: 16px; }
.qa dt { font-weight: 500; }
.qa dt::before { content: "Q  "; color: var(--amber); }
.qa dd { margin: 3px 0 0; color: var(--dim); }
.qa dd::before { content: "A  "; color: var(--faint); }

/* ---------- close ---------- */
.closing { padding-block: 54px 42px; }
.closing .big { font-size: clamp(19px, 4.2vw, 32px); line-height: 1.4; font-weight: 500;
  margin: 16px 0 4px; letter-spacing: -.01em; }
.cta-row { display: flex; align-items: baseline; column-gap: 3ch; row-gap: 8px; margin: 18px 0 6px; flex-wrap: wrap; }
.legal { color: var(--faint); margin-top: 30px; font-size: 13px; }

/* ---------- responsive ---------- */
@media (max-width: 620px) {
  .nav { padding: 0 14px; gap: 1.6ch; }
  .nav__links { display: none; }
  .term { padding: 0 16px; }
  .man > div { grid-template-columns: 1fr; gap: 0; }
  .tsec { padding-block: 40px; }
}
@media (max-width: 560px) {
  .tt .hm, .tt .pct { display: none; }
  .tt th, .tt td { padding-right: 1.6ch; }
  .pane .bars { display: none; } .pane .bars--s { display: inline; }
}
@media (max-width: 440px) {
  .tt .hs { display: none; }
  .pane .bars, .pane .bars--s { display: none; }
}
@media (max-width: 400px) {
  body { font-size: 13.5px; }
  .tt { font-size: 12.5px; }
  .pane { padding: 12px 12px; }
}
</style>
</head>
<body>
<a class="skip" href="#top"><%= t("landing.a11y.skip") %></a>

<header class="nav">
  <a class="nav__logo" href="#top">beacondock<span class="cur" aria-hidden="true"></span></a>
  <nav class="nav__links" aria-label="<%= t("landing.a11y.sections") %>">
    <a href="#watch">watch</a><a href="#man">man</a><a href="#status">status</a><a href="#api">api</a><a href="#faq">faq</a>
  </nav>
  <div class="nav__act">
    <a class="signin" href="<%= new_session_path %>"><%= t("landing.nav.sign_in") %></a>
    <a class="btn-inv" href="<%= sign_up_path %>"><%= t("landing.cta.start") %></a>
  </div>
</header>

<main id="top">

<section class="tsec tsec--hero" id="watch" aria-label="<%= t("landing.a11y.session") %>">
  <div class="term">
    <p class="tl"><span class="ps1" aria-hidden="true">beacondock@prod:~$</span> <span class="typed">./beacondock --version</span></p>
    <h1 class="tl">beacondock 0.9 — <%= t("landing.session.tagline") %></h1>
    <p class="tl dim"><%= t("landing.session.stack") %></p>

    <p class="tl" style="margin-top:2.1em"><span class="p1" aria-hidden="true">$</span> ./beacondock watch</p>
    <div class="tt-wrap">
      <table class="tt">
        <thead><tr>
          <th><%= t("landing.table.monitor") %></th><th class="hm"><%= t("landing.table.method") %></th><th class="hm"><%= t("landing.table.every") %></th><th><%= t("landing.table.status") %></th><th class="hs"><%= t("landing.table.latency") %></th><th><%= t("landing.table.uptime") %></th>
        </tr></thead>
        <tbody>
          <tr><td>api.acme.dev</td><td class="dim hm">GET</td><td class="dim hm">30 s</td><td class="up"><%= t("landing.st.up") %></td><td class="dim hs">84 ms</td><td><span class="bars" aria-hidden="true">▇▇▇▇▇▇▇▇▇▇</span> <span class="pct">100%</span></td></tr>
          <tr><td>app.acme.dev</td><td class="dim hm">GET</td><td class="dim hm">30 s</td><td class="up"><%= t("landing.st.up") %></td><td class="dim hs">121 ms</td><td><span class="bars" aria-hidden="true">▇▇▇▇▇▇▇▇▇▇</span> <span class="pct">99.98%</span></td></tr>
          <tr><td>docs.acme.dev</td><td class="dim hm">GET</td><td class="dim hm">60 s</td><td class="warn"><%= t("landing.st.degraded") %></td><td class="dim hs">240 ms</td><td><span class="bars" aria-hidden="true">▇▇▇▇▇▇<span class="warn">▁</span>▇▇▇</span> <span class="pct">99.61%</span></td></tr>
          <tr><td>billing.acme.dev</td><td class="dim hm">GET</td><td class="dim hm">30 s</td><td class="down"><%= t("landing.st.down") %></td><td class="dim hs">—</td><td><span class="bars" aria-hidden="true">▇▇▇<span class="down">xx</span>▇▇▇▇▇</span> <span class="pct">98.12%</span></td></tr>
        </tbody>
      </table>
    </div>
    <div class="log">
      <p class="tl"><span class="warn" aria-hidden="true">!</span> <span class="dim">14:28</span> <span class="down"><%= t("landing.log.opened") %></span>  billing.acme.dev — <span class="dim"><%= t("landing.log.opened_detail") %></span></p>
      <p class="tl"><span class="up" aria-hidden="true">✓</span> <span class="dim">14:31</span> <span class="up"><%= t("landing.log.resolved") %></span> billing.acme.dev — <span class="dim"><%= t("landing.log.resolved_detail") %></span></p>
    </div>

    <p class="tl" style="margin-top:1.7em"><span class="p1" aria-hidden="true">$</span><span class="cur" aria-hidden="true"></span></p>
    <div class="cta-row">
      <a class="btn-inv" href="<%= sign_up_path %>"><%= t("landing.cta.start") %></a>
      <a class="signin" href="<%= new_session_path %>"><span class="dim">→</span> <%= t("landing.cta.signin") %></a>
    </div>
    <p class="tl faint" style="font-size:13px"><span aria-hidden="true">#</span> <%= t("landing.session.proof") %></p>
  </div>
</section>

<section class="tsec" id="man" aria-labelledby="man-h">
  <div class="term">
    <h2 class="tsec__h" id="man-h">man beacondock</h2>
    <dl class="man">
      <div><dt><%= t("landing.man.checks_t") %></dt><dd><%= t("landing.man.checks_d") %></dd></div>
      <div><dt><%= t("landing.man.incidents_t") %></dt><dd><%= t("landing.man.incidents_d") %></dd></div>
      <div><dt><%= t("landing.man.status_t") %></dt><dd><%= t("landing.man.status_d") %></dd></div>
      <div><dt><%= t("landing.man.api_t") %></dt><dd><%= t("landing.man.api_d") %></dd></div>
      <div><dt><%= t("landing.man.tui_t") %></dt><dd><%= t("landing.man.tui_d") %></dd></div>
    </dl>
  </div>
</section>

<section class="tsec" id="status" aria-labelledby="status-h">
  <div class="term">
    <h2 class="tsec__h" id="status-h">./beacondock status --public</h2>
    <div class="pane">
      <div class="pane__head"><span>status.acme.dev</span><span class="up">● <%= t("landing.status_pane.operational") %></span></div>
      <div class="pane__row"><span class="name">api.acme.dev</span><span class="up st"><%= t("landing.st.up") %></span><span class="bars" aria-hidden="true">▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇</span><span class="bars bars--s" aria-hidden="true">▇▇▇▇▇▇▇▇▇▇▇▇</span></div>
      <div class="pane__row"><span class="name">app.acme.dev</span><span class="up st"><%= t("landing.st.up") %></span><span class="bars" aria-hidden="true">▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇▇</span><span class="bars bars--s" aria-hidden="true">▇▇▇▇▇▇▇▇▇▇▇▇</span></div>
      <div class="pane__row"><span class="name">docs.acme.dev</span><span class="warn st"><%= t("landing.st.deg") %></span><span class="bars" aria-hidden="true">▇▇▇▇▇▇▇▇<span class="warn">▁</span>▇▇▇▇▇<span class="down">x</span>▇▇▇▇▇</span><span class="bars bars--s" aria-hidden="true">▇▇▇▇▇▁▇▇▇▇<span class="down">x</span>▇</span></div>
      <p class="tl dim" style="margin-top:10px"><%= t("landing.status_pane.week") %></p>
    </div>
  </div>
</section>

<section class="tsec" id="api" aria-labelledby="api-h">
  <div class="term">
    <h2 class="tsec__h" id="api-h">curl -X POST /api/v1/monitors</h2>
    <div class="pre" aria-hidden="true"><span class="k">curl</span> -X POST https://your.host/api/v1/monitors \
  -H <span class="s">"Authorization: Bearer bd_…"</span> \
  -d <span class="s">url=api.acme.dev/health</span>
<span class="c">→ 201 Created</span>
{ "id": 42, "name": "api.acme.dev", "status": "pending", "interval_s": 30 }</div>
    <p class="tl" style="margin-top:1.4em"><span class="p1" aria-hidden="true">$</span> ./beacondock keys create ci</p>
    <div class="pre" aria-hidden="true">→ bd_live_k3x9…   <span class="c"><%= t("landing.api_sec.keys_note") %></span></div>
  </div>
</section>

<section class="tsec" id="faq" aria-labelledby="faq-h">
  <div class="term">
    <h2 class="tsec__h" id="faq-h">./beacondock faq</h2>
    <dl class="qa">
      <div><dt><%= t("landing.faq.q1") %></dt><dd><%= t("landing.faq.a1") %></dd></div>
      <div><dt><%= t("landing.faq.q2") %></dt><dd><%= t("landing.faq.a2") %></dd></div>
      <div><dt><%= t("landing.faq.q3") %></dt><dd><%= t("landing.faq.a3") %></dd></div>
      <div><dt><%= t("landing.faq.q4") %></dt><dd><%= t("landing.faq.a4") %></dd></div>
      <div><dt><%= t("landing.faq.q5") %></dt><dd><%= t("landing.faq.a5") %></dd></div>
    </dl>
  </div>
</section>

</main>

<footer class="closing term" id="start">
  <p class="tl"><span class="p1" aria-hidden="true">$</span> sudo ./beacondock start</p>
  <p class="big"><%= t("landing.close.line") %></p>
  <div class="cta-row">
    <a class="btn-inv" href="<%= sign_up_path %>"><%= t("landing.cta.start") %></a>
    <a class="signin" href="<%= new_session_path %>"><span class="dim">→</span> <%= t("landing.cta.signin") %></a>
  </div>
  <p class="tl legal"><span aria-hidden="true">#</span> <%= t("landing.footer.legal") %></p>
  <p class="tl" style="margin-top:16px"><span class="ps1" aria-hidden="true">beacondock@prod:~$</span> <span class="cur" aria-hidden="true"></span></p>
</footer>

</body>
</html>
