          <div class="faq__item"><h3><%= t("landing.faq.q5") %></h3><p><%= t("landing.faq.a5") %></p></div>
        </div>
        <div class="span-6 start-7">
          <div class="panel" style="--p-h:210px">
            <div class="glance">
              <p class="glance__h"><%= t("landing.faq.glance_h") %></p>
              <div class="glance__col"><b class="up">99.98%</b><span><%= t("landing.faq.glance_uptime") %></span></div>
              <div class="glance__col"><b>86,400</b><span><%= t("landing.faq.glance_checks") %></span></div>
              <div class="glance__col"><b class="deg">2</b><span><%= t("landing.faq.glance_incidents") %></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
