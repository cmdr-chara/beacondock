<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-type="software">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="site-kind" content="software">
    <meta name="page-type" content="software">
    <meta name="description" content="<%= t("app.description") %>">
    <meta name="theme-color" content="#0b1020">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= t("app.name") %>">
    <meta property="og:title" content="<%= content_for(:title) || t("app.name") %>">
    <meta property="og:description" content="<%= t("app.description") %>">
    <meta property="og:image" content="<%= request.base_url %>/icon.png">
    <meta name="twitter:card" content="summary_large_image">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preload" href="/fonts/geist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/geist-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%#
    tasteskill 2.5.1 — kind: software (developer-tool SaaS), page-type: app screens.
    Deal: client's own colours via `start.mjs brand` — dark navy ground #0b1020,
    blue accent #4f8cff, sharp radius; type pairing `geist` (Geist + Geist Mono,
    vendored woff2 in /public/fonts). Marketing sections/moments do not apply to
    authenticated app screens; the system's discipline (one button, one card,
    status colour on data, equal edges, hover/press/focus) does.
  %>
  <body>
    <a class="skip-link" href="#main"><%= t("a11y.skip_to_content") %></a>

    <header class="site-header">
      <nav class="nav container" data-controller="nav">
        <%= link_to dashboard_path, class: "brand" do %>
          <%= brand_mark %>
          <span class="brand-name"><%= t("app.name") %></span>
        <% end %>

        <button type="button" class="nav-toggle" data-nav-target="toggle" data-action="nav#toggle"
                aria-expanded="false" aria-controls="primary-nav" aria-label="<%= t("nav.toggle") %>">
          <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>

        <div class="nav-links" id="primary-nav" data-nav-target="menu">
          <% if authenticated? %>
            <%= link_to t("nav.dashboard"), dashboard_path, class: ("is-active" if current_page?(dashboard_path)), "aria-current": ("page" if current_page?(dashboard_path)) %>
            <%= link_to t("nav.api_keys"), api_keys_path, class: ("is-active" if current_page?(api_keys_path)), "aria-current": ("page" if current_page?(api_keys_path)) %>
            <%= link_to t("nav.status_page"), status_page_path(token: Current.user.status_page_token), target: "_blank", rel: "noopener" %>
            <span class="nav-user"><%= Current.user.email_address %></span>
            <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
          <% else %>
            <%= link_to t("nav.sign_in"), new_session_path, class: ("is-active" if current_page?(new_session_path)), "aria-current": ("page" if current_page?(new_session_path)) %>
            <%= link_to t("nav.sign_up"), sign_up_path, class: "btn btn-primary btn-sm #{'is-active' if current_page?(sign_up_path)}" %>
          <% end %>
          <span class="locale-switch">
            <%= link_to "EN", url_for(locale: :en), class: (I18n.locale == :en ? "active" : nil), "aria-label": "English" %>
            <%= link_to "IT", url_for(locale: :it), class: (I18n.locale == :it ? "active" : nil), "aria-label": "Italiano" %>
          </span>
        </div>
      </nav>
    </header>

    <main class="container" id="main">
      <% if flash[:notice].present? %>
        <div class="flash flash-notice" role="status">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span><%= flash[:notice] %></span>
        </div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="flash flash-alert" role="alert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <span><%= t("app.tagline") %></span>
        <span class="small"><%= t("app.name") %></span>
      </div>
    </footer>
  </body>
</html>
