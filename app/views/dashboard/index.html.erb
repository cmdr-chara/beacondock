<% content_for :title, t(".title") %>

<%= turbo_stream_from Current.user, :monitors %>

<div class="page-header">
  <div>
    <h1><%= t(".title") %></h1>
    <% if @monitors.any? %>
      <% counts = @monitors.each_with_object(Hash.new(0)) { |m, h| h[m.last_status] += 1 } %>
      <div class="fleet-summary">
        <span class="fleet-total"><%= t(".monitor_count", count: @monitors.size) %></span>
        <% %w[up down degraded pending].each do |status| %>
          <% next if counts[status].zero? %>
          <span class="fleet-chip is-<%= status %>"><span class="dot"></span><%= counts[status] %> <%= t("statuses.#{status}") %></span>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= link_to t(".new_monitor"), new_monitor_path, class: "btn btn-primary" %>
</div>

<% if @monitors.any? %>
  <div id="monitors" class="monitor-grid">
    <%= render @monitors %>
  </div>
<% else %>
  <div id="monitors" class="monitor-grid">
    <div class="empty-state">
      <h2><%= t(".empty_title") %></h2>
      <p><%= t(".empty_body") %></p>
      <%= link_to t(".new_monitor"), new_monitor_path, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
