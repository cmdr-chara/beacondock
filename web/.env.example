# BeaconDock API (the Rails app, bin/dev -> :3000). The key is read server-side
# only; it is never sent to the browser.
BEACONDOCK_API_URL=http://localhost:3000
BEACONDOCK_API_KEY=bd_...

# Web-layer store: console preferences and alert rules (never monitor data).
# Optional — when unreachable the console works with defaults.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=beacondock_console
